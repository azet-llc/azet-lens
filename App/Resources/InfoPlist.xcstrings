{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSScreenCaptureUsageDescription": {
      "comment": "Privacy prompt for Screen Recording",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyea reads the text under your lenses so it can translate it in place."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈 아래의 글자를 읽어 그 자리에서 번역하는 데 쓰입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyeaは、レンズの下にあるテキストを読み取り、その場で翻訳するために画面を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyea 会读取透镜下方的文字,并就地翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyea 會讀取透鏡下方的文字,並就地翻譯。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyea liest den Text unter einer Linse und übersetzt ihn direkt an Ort und Stelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyea lit le texte sous une loupe pour le traduire sur place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyea lee el texto que hay bajo una lupa para traducirlo en el mismo lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyea читает текст под линзой, чтобы перевести его прямо на месте."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mwoyea lê o texto sob uma lente para traduzi-lo no próprio lugar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyea legge il testo sotto una lente per tradurlo sul posto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwoyea читає текст під лінзою, щоб перекласти його прямо на місці."
          }
        }
      }
    }
  }
}